{
  "name": "desgracias-staging-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "start": "node src/api.js",
    "start:ops": "node --import ./src/publish-processor.js src/ops-api.js",
    "worker": "node src/worker.js",
    "rank:opportunities": "node scripts/rank-opportunities.mjs --limit=20",
    "report:opportunities": "node scripts/decision-report.mjs",
    "audit:accessibility": "node scripts/audit-accessibility.mjs",
    "audit:performance": "node scripts/audit-performance-budget.mjs",
    "audit:ops-readiness": "node scripts/audit-ops-readiness.mjs",
    "audit:backup-readiness": "node scripts/audit-backup-readiness.mjs",
    "audit:strategic-meta-brain": "node --test tests/strategic-meta-brain.test.js",
    "test:story-updates": "node --test tests/story-update-policy.test.js",
    "test:needs-router": "node --test tests/human-needs-router.test.js",
    "test:decision-ledger": "node --test tests/decision-ledger.test.js",
    "test": "node --test tests/*.test.js tests/*.test.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "pg": "^8.16.3"
  }
}

